{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poco Root Assistant",
  "version": "0.1.0",
  "identifier": "com.cmssmc.pocorootassistant",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Poco Root Assistant",
        "width": 1040,
        "height": 780,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "cmssmc-code",
    "category": "Utility",
    "shortDescription": "Assistant de root pour POCO X6 5G",
    "longDescription": "Assistant guidé et semi-automatique pour rooter un POCO X6 5G (garnet) avec Magisk. Automatise adb/fastboot et le flash, et indique clairement les étapes verrouillées par Xiaomi.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
